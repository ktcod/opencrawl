{
  "name": "opencrawl",
  "version": "0.3.0",
  "description": "Local, keyless web scraper: MCP server, v2-style HTTP API, CLI and library. Scrape, map, crawl, search and parse without an account or credits.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opencrawl": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:mcp": "tsx src/cli.ts mcp",
    "dev:serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cache",
    "change-detection",
    "crawler",
    "extraction",
    "full-text-search",
    "json-ld",
    "markdown",
    "mcp",
    "microdata",
    "open-source",
    "opengraph",
    "playwright",
    "scraper",
    "self-hosted",
    "sqlite",
    "tables"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktcod/opencrawl.git"
  },
  "homepage": "https://github.com/ktcod/opencrawl#readme",
  "bugs": {
    "url": "https://github.com/ktcod/opencrawl/issues"
  },
  "author": "Kenneth Ta"
}
